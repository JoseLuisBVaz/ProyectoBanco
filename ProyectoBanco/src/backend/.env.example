# ==================== CONFIGURACIÓN DE EMAIL ====================
# Variables de entorno para el servicio de correo

# Correo electrónico del remitente
EMAIL_USER=tu-correo@gmail.com

# Contraseña de aplicación (NO usar contraseña real)
# Para Gmail: https://myaccount.google.com/apppasswords
EMAIL_PASS=tu-app-password-aqui

# URLs del sistema
RESET_PASSWORD_URL=http://localhost:4200/reset-password
DASHBOARD_URL=http://localhost:4200/main
SUPPORT_URL=http://localhost:4200/support

# ==================== CONFIGURACIÓN DE BASE DE DATOS ====================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu-password
DB_NAME=nombre-base-datos

# ==================== CONFIGURACIÓN DEL SERVIDOR ====================
PORT=3000
NODE_ENV=development
